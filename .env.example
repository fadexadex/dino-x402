# resource server (NO Hedera key — server signs nothing)
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
PAY_TO_ACCOUNT=0.0.xxxx
DATA_PROVIDER=market
PORT=4021

# Server-managed agent treasury + x402 payer (scripts/e2e-pay.ts, Mode 4 autonomy).
# Users who choose full autonomy fund THIS account; the server signs with HEDERA_CLIENT_KEY.
HEDERA_CLIENT_ID=0.0.yyyy
HEDERA_CLIENT_KEY=
SERVER_URL=http://localhost:4021
# signer policy: fail closed unless every field matches
SIGNER_ALLOWED_ORIGIN=http://localhost:4021
SIGNER_ALLOWED_ASSET=0.0.0
SIGNER_MAX_AMOUNT_ATOMIC=5000000
E2E_PRODUCT=spot-price
E2E_SYMBOL=HBAR

# optional AI agent orchestration (server-side only)
AGENT_DATA_BASE_URL=http://localhost:4021
AGENT_MAX_SPEND_ATOMIC=5000000
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# autonomous portfolio and SaucerSwap V2 testnet (official deployment defaults)
MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com
SAUCERSWAP_ROUTER_ID=0.0.1414040
SAUCERSWAP_QUOTER_ID=0.0.1390002
SAUCERSWAP_WHBAR_TOKEN_ID=0.0.15058
SAUCERSWAP_USDC_TOKEN_ID=0.0.5449
SAUCERSWAP_SAUCE_TOKEN_ID=0.0.1183558
SAUCERSWAP_FEE_TIER=3000
TRADE_MAX_AMOUNT_TINYBAR=1000000000
TRADE_SLIPPAGE_BPS=100

# No SaucerSwap API key is required: executable quotes come from QuoterV2 on Hedera.

# Web WalletConnect (copy into web/.env for Astro)
# PUBLIC_REOWN_PROJECT_ID=from https://dashboard.reown.com/
# PUBLIC_APP_URL=http://localhost:4321
