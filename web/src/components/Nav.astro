---
import { site } from "../data/site.ts";
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-bg/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-6" aria-label="Primary navigation">
    <a href="#top" class="focus-ring flex items-center gap-2 rounded-md font-semibold tracking-[-0.02em]">
      <span class="grid size-7 place-items-center rounded-md bg-text text-xs font-bold text-white">M</span>
      MarketRail
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {site.nav.map((item) => <a href={item.href} class="focus-ring rounded text-sm text-muted transition hover:text-text">{item.label}</a>)}
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden items-center gap-1.5 text-xs text-faint sm:flex"><span class="size-1.5 rounded-full bg-success"></span>Testnet live</span>
      <a href={site.repoUrl} class="focus-ring rounded-lg border border-border bg-surface px-3.5 py-2 text-sm font-semibold text-text transition hover:border-accent/40">GitHub ↗</a>
    </div>
  </nav>
</header>
